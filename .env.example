# LLM used by every agent and AI node (see src/workflows/dynamic_workflow_orchestrator.py)
LLM_PROVIDER=ollama          # ollama | openai | groq
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.5
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Flask session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Tools
# TAVILY_API_KEY=
# SENDGRID_API_KEY=
